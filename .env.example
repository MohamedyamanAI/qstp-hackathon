# Supabase project credentials.
# Get these from https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_VERTEX_API_KEY=your-vertext-ai-key
# Optional: used to build absolute redirect URLs in email templates.
# Falls back to the request's forwarded host, then to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- For scripts/sync-email-templates.mjs (server-side only, never expose) ---
# Personal access token: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
# Project ref from: https://supabase.com/dashboard/project/_/settings/general
# SUPABASE_PROJECT_REF=your-project-ref

# --- Notifications: Resend (transactional email) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address. Must be on a domain you've verified in Resend.
# RESEND_FROM_EMAIL=QSTP Notifications <notifications@yourdomain.com>

# --- Integrations: Stripe Connect OAuth (server-side only, never expose) ---
# Create a Connect platform, add /api/integrations/stripe/callback as the redirect URI.
# STRIPE_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# STRIPE_OAUTH_STATE_SECRET=generate-a-long-random-secret

# --- Integrations: Google Workspace OAuth (server-side only, never expose) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <site-url>/api/integrations/google/callback
# Required scopes: openid email profile, gmail.readonly, drive.metadata.readonly
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_STATE_SECRET=generate-a-long-random-secret

# --- Notifications: Web Push (VAPID) ---
# Generate once with: pnpm exec web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A mailto: URL the push provider can contact you at.
# VAPID_SUBJECT=mailto:notifications@yourdomain.com
